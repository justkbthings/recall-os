{
  "name": "recall-os",
  "productName": "Recall OS",
  "private": true,
  "version": "1.5.0",
  "description": "A private, local-first active recall and spaced repetition desktop app.",
  "author": "Karabo Goodwill Nkambule",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "config": {
    "forge": "./forge.config.cjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "desktop:start": "npm run build && electron .",
    "desktop:package": "npm run build && electron-forge package",
    "desktop:make": "npm run build && node scripts/build-desktop.cjs",
    "profile:backup": "node scripts/export-profile.cjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.8",
    "electron-squirrel-startup": "^1.0.1",
    "katex": "^0.18.1",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron/windows-sign": "^2.0.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.1",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
